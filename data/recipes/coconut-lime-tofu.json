  "steps": [
    "Blend curry paste ingredients to a smooth paste (soak chillies if tough).",
    "Toss tofu cubes in corn flour; pan-fry in sesame oil until crisp at edges. Set aside.",
    "Sauté onion, garlic, ginger. Stir in sriracha and red curry paste; cook until fragrant.",
    "Pour in coconut milk; simmer to desired thickness. Season with brown sugar and soy sauce.",
    "Return tofu; simmer briefly. Finish with lemon/lime juice. Garnish with scallions and sesame."
  ],
  "tips": [
    "Use tamari for gluten-free.",
    "Adjust curry paste and sriracha for heat preference.",
    "Silken-firm tofu is delicate—turn gently while frying."
